#======================================================================
# Mega AI — environment template
# 1) copy:   cp .env.example .env
# 2) edit:   SITE_DOMAIN, ACME_EMAIL, ANTHROPIC_API_KEY (and SMTP if used)
# 3) run:    ./setup.sh      (fills the blank secrets below)
# 4) start:  docker compose up -d
# NEVER commit .env (it holds secrets). Only this .env.example is tracked.
#======================================================================

#--- Public site / HTTPS -------------------------------------------------
SITE_DOMAIN=ai.megatrust.net
ACME_EMAIL=it.egypt@megatrust.net
DOMAIN_CLIENT=https://ai.megatrust.net
DOMAIN_SERVER=https://ai.megatrust.net

#--- App identity (Mega Trust branding) ---------------------------------
APP_TITLE=Mega AI
CUSTOM_FOOTER=Mega Trust Group — Internal AI

#--- Access control -----------------------------------------------------
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false

#--- Scheduler / agent triggers (single replica) ------------------------
SCHEDULES_SINGLE_PROCESS=true

#--- Security secrets --- GENERATED by ./setup.sh (leave blank) ---------
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=
ADMIN_PANEL_SESSION_SECRET=
POSTGRES_PASSWORD=

#--- AI provider keys (SERVER-SIDE — employees never see them) ----------
# Put the org key here so staff consume it under per-user token budgets.
# Leave a provider blank to hide it; use "user_provided" to let each user paste their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=user_provided

#--- Optional: local model via Ollama (unlimited, no API cost) ----------
# Runs only if an Ollama server is reachable at the URL in librechat.yaml.
# On the prod host, run Ollama and set OLLAMA_HOST so the container can reach it.

#--- Optional: email for invites / password reset (reuse Mega Trust SMTP)-
# EMAIL_SERVICE=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=ai@megatrust.net
# EMAIL_FROM_NAME=Mega AI

#--- RAG document-search embeddings (optional) --------------------------
# RAG_OPENAI_API_KEY=
