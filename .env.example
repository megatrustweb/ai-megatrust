#======================================================================
# Mega AI — environment template
# 1) copy:   cp .env.example .env
# 2) edit:   SITE_DOMAIN, ACME_EMAIL (and SMTP if used)
# 3) run:    ./setup.sh             (fills the blank secrets below)
# 4) start:  docker compose up -d
# 5) tiers:  ./scripts/provision.sh  (creates the access tiers + sign-up gate)
# API KEYS: add them in the Admin Panel → Configuration (stored ENCRYPTED),
#           no need to put them here. NEVER commit .env.
#======================================================================

#--- Public site / HTTPS -------------------------------------------------
SITE_DOMAIN=ai.megatrust.net
ACME_EMAIL=it.egypt@megatrust.net
DOMAIN_CLIENT=https://ai.megatrust.net
DOMAIN_SERVER=https://ai.megatrust.net
# Caddy is the only proxy in front of LibreChat -> trust 1 hop to get real client IPs.
# If you ever put Cloudflare (proxied) in front of Caddy, set this to 2.
TRUST_PROXY=1

#--- App identity (Mega Trust branding) ---------------------------------
APP_TITLE=Mega AI
CUSTOM_FOOTER=Mega Trust Group — Internal AI

#--- Access control -----------------------------------------------------
# Anyone can sign up with ANY email. New accounts land in the USER role,
# which is the "⏳ Pending activation" tier until an admin activates them.
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
# Show built-in providers only through our custom (panel-managed) endpoints.
ENDPOINTS=custom,agents
# Admin Panel link shown in Settings → General (panel reached via SSH tunnel).
ADMIN_PANEL_URL=http://localhost:3000

#--- Scheduler / agent triggers (single replica) ------------------------
SCHEDULES_SINGLE_PROCESS=true

#--- Security secrets --- GENERATED by ./setup.sh (leave blank) ---------
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=
ADMIN_PANEL_SESSION_SECRET=
POSTGRES_PASSWORD=
MEGA_TOOLS_KEY=
SEARXNG_SECRET=

#--- AI provider keys -------------------------------------------------
# RECOMMENDED: leave these blank and enter each key in the Admin Panel →
# Configuration → Endpoints (stored encrypted). Values here also work.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_KEY=
CLAUDE_API_KEY=
# Native web-search scraper (free tier) and fal.ai image/video generation:
TAVILY_API_KEY=
FAL_KEY=

#--- Optional: email for verification / password reset ------------------
# Without email, new accounts are auto-verified (the activation gate still applies).
# EMAIL_SERVICE=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=ai@megatrust.net
# EMAIL_FROM_NAME=Mega AI

#--- RAG document-search embeddings (optional) --------------------------
# RAG_OPENAI_API_KEY=
